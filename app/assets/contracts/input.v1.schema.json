{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aos.local/contracts/input.v1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "todo_toggle"
        },
        "client_event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "observed_revision": {
          "type": "integer",
          "minimum": 0
        },
        "section_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "target_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "done": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "client_event_id",
        "observed_revision",
        "section_id",
        "target_id",
        "done"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "overlay_dismissed"
        },
        "overlay_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "client_event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "observed_revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "client_event_id",
        "observed_revision",
        "overlay_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "remote_key"
        },
        "client_event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "observed_revision": {
          "type": "integer",
          "minimum": 0
        },
        "key": {
          "enum": [
            "up",
            "down",
            "left",
            "right",
            "ok",
            "back"
          ]
        }
      },
      "required": [
        "kind",
        "client_event_id",
        "observed_revision",
        "key"
      ],
      "additionalProperties": false
    }
  ]
}
